# Copy to .env (git-ignored) and set local-only passwords. Keep DB and USER as they are:
# the API's connection string and the Compose healthcheck use these names.
POSTGRES_DB=tutoring
POSTGRES_USER=tutoring_dev
POSTGRES_PASSWORD=

# Passwords for the two least-privilege roles the bootstrap script creates
# (db/bootstrap-roles.sh): tutoring_owner runs migrations, tutoring_app is the
# API's runtime login. Set different local-only passwords for each.
TUTORING_OWNER_PASSWORD=
TUTORING_APP_PASSWORD=

# Only used by the local production stack's one-shot seed job (compose.prod.yaml, Task 34.8):
# docker compose -f compose.yaml -f compose.prod.yaml up --build
DEMO_SEED_PASSWORD=
