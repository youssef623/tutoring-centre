# Editor and code-style rules for the whole repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# TypeScript, JavaScript, JSON, YAML, CSS, HTML: 2 spaces
[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,html}]
indent_size = 2

# MSBuild and solution files: 2 spaces
[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
# Style preferences are suggestions (IDE hints), never build errors.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true

# Test method names use Method_Condition_Result. CA1707 (no underscores in identifiers) is documented
# by Microsoft as safe to disable for test code; production code keeps the rule.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
