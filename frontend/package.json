    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.3",
    "i18next-icu": "^2.6.1",
    "intl-messageformat": "^11.2.15",
    "lucide-react": "^1.60.0",
